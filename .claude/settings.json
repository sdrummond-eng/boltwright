{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/block-verification-write.sh\"",
            "timeout": 10,
            "statusMessage": "Checking the verification gate"
          }
        ]
      }
    ]
  }
}
